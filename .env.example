# MT5 Server Configuration
# Direct IP: 86.104.251.153 / Port: 443
# When using an ngrok TCP tunnel, set MT5_SERVER and MT5_PORT to your ngrok forwarding address
# Example:
# MT5_SERVER=0.tcp.ngrok.io
# MT5_PORT=15432
MT5_SERVER=ip_here
MT5_PORT=port_here

# Manager Account Credentials (requires Manager API permissions and IP whitelisting)
MT5_LOGIN=your_manager_login
MT5_PASSWORD=your_manager_password
MT5_GROUP=demo\demoforex

# Connection Settings
# Timeout in milliseconds (15000 ms ensures sufficient handshake time over tunnels)
MT5_TIMEOUT_MS=15000

# Pump Mode: 0 = no background data pump (recommended for queries), or bitmask flags
MT5_PUMP_MODE=0
